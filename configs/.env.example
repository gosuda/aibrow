# AIBrow environment configuration

# Server ports. If a port is busy, the next available port is used automatically.
REST_PORT=8080
SWAGGER_PORT=8081

# Logging and storage paths
LOG_PATH=logs/error.log
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# LLM provider credentials. Only fill in the providers you want to use.
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROVIDER=openai
